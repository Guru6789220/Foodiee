<div class="container-fluid">
    <div class="row">
        <div class="col-lg-2">
            <div class="card shadow-lg" style="margin:1% 0px 0px 0px;border:none;border-radius:10px;height:30vh;">
                <div class="card-header text-center customheader">
                    <p class="display-3 gradient-text" style="font-size:18px !important;">New Launch's</p>
                </div>
                <div class="card-body p-0">
                    <img class="NewImages" src="https://static.tnn.in/thumb/msid-111582131,thumbsize-12712,width-1280,height-720,resizemode-75/111582131.jpg?quality=100" />
                </div>
                <div class="card-footer customfooter">
                    <p style="font-size:14px;margin:-7px 0px 0px 0px;">On Janaray 08 12:30PM</p>
                </div>
            </div>
        </div>
        <div class="col-lg-8">
            <div class="card" style="border-radius:10px;">
                <div class="card-body p-0">
                    <div id="carouselExampleSlidesOnly" class="carousel slide" data-bs-ride="carousel">
                        <div class="carousel-inner">
                            <div class="carousel-item active">
                                <img style="width:100%;height:30vh;border-radius:10px;object-fit:cover" src="https://rukminim2.flixcart.com/fk-p-flap/1600/270/image/614c92ccb25152fe.jpg?q=20" class="d-block w-100" alt="">
                            </div>
                            <div class="carousel-item">
                                <img style="width:100%;height:30vh;border-radius:10px;" src="https://rukminim2.flixcart.com/fk-p-flap/1600/270/image/3c93e011a12d4fea.jpg?q=20" class="d-block w-100" alt="...">
                            </div>
                            <div class="carousel-item">
                                <img style="width:100%;height:30vh;border-radius:10px;" src="https://images-eu.ssl-images-amazon.com/images/G/31/img24hp/urec/hero/Under1499_Tallhero_3000x1200._CB568928188_.jpg" class="d-block w-100" alt="...">
                            </div>
                            <div class="carousel-item">
                                <img style="width:100%;height:30vh;border-radius:10px;" src=" https://images-eu.ssl-images-amazon.com/images/G/31/img22/Wireless/devjyoti/GW/Uber/Nov/D103625178_DesktopTallHero_3000x1200_V3._CB558389732_.jpg" class="d-block w-100" alt="...">
                            </div>

                        </div>
                    </div>

                </div>
            </div>
        </div>
        <div class="col-lg-2">
            <div class="card shadow-lg" style="margin:1% 0px 0px 0px;border:none;border-radius:10px;height:30vh;">
                <div class="card-header text-center customheader">
                    <p class="display-3 gradient-text" style="font-size:18px !important;">Best Offer's</p>
                </div>
                <div class="card-body p-0">
                    <img class="NewImages" src="https://cdn2.desidime.com/cdn-cgi/image/fit=crop,f=auto,onerror=redirect,w=1200,h=1200,q=90/topics/photos/1471816/original/New_Cashback_and_discount_offers_on_bank_credit_cards_and_debit_cards_2022.jpg" />
                </div>
            </div>
        </div>

    </div>
    <br />
    <div class="row">
        <div class="card shadow-sm">
            <div class="card-header header">
                <h4 class="display-3 Heading">Best Deal's On Electronics</h4>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-12">
                        <!-- Set the width to allow horizontal scroll and prevent vertical scroll -->
                        <div class="BestDeals">
                            @foreach (var products in ViewBag.ProductDetails)
                            {
                                string filepath = products.Images.Replace("E:\\MVC\\UploadedFiles\\", "/uploadedfiles/");
                                <div class="card ProductCard" >
                                    <div class="rateing"><i class="bi bi-star-fill star"></i><span>4.2</span></div>
                                    <div class="Heart"><i class="bi bi-heart-fill"></i></div>
                                    <div class="card-header p-0 card-img">
                                        <img class="ProductImages" src="@filepath" />
                                    </div>
                                    <div class="card-body p-0">
                                        <div class="row">
                                            <div class="col-lg-12 p-0">
                                                <p id="productname" class="productname">
                                                   @products.ProductName<br />
                                                    @products.ProductDescription
                                                </p>
                                            </div>
                                        </div>
                                        <div class="row">
                                            <div class="col-lg-8 d-flex justify-content-center p-0">
                                                <strike class="baseprice">₹@products.BasicPrice</strike>&nbsp;&nbsp;<span class="discountprice">₹<span>8500</span></span>
                                            </div>
                                            <div class="col-lg-4 p-0">
                                                <div class="discount text-center p-0">
                                                <span class="discountpercen"><span>10%</span> off</span>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="row">
                                            <div class="col-lg-12">
                                                <span class="saletimmer">Sale Ends in 00:00:00</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>


            </div>
        </div>
    </div>
    <div class="card">
        <div class="card-body">
            <div class="row">
                <div class="col-lg-12 d-flex justify-content-evenly">
                @foreach (var logo in ViewBag.BrandLogo)
                {
                        <button class="logolist" style="background-image:url('@logo.BrandLogo');"></button>   
                }
                </div>
            </div>
        </div>
    </div>
</div>
