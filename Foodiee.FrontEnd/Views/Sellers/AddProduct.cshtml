@model ProductsDTO;

<style>
    .flex-container{
        flex-direction:column;
        display:flex;
        padding: 0px;
    }

    .flex-items{
        border-top: 1px solid #808080ab;
        border-left: 1px solid #808080ab;
        border-right: 1px solid #808080ab;
        border-radius:5px;
        width:90%;
        height:60px;
    }
    .flex-items:last-child{
        border-bottom:1px solid gray;
    }

    .ImgStyle{
        width:100%;
        height:100%;
        padding:2px;
        border-radius:5px;
    }
    .ProductHighlight{
        display:none;
    }

    
</style>


<form method="post" asp-action="AddProduct" enctype="multipart/form-data">
<div class="container-fluid">
    <div class="card mt-1 mb-1">
        <div class="card-header text-center">
            <h5 style="color:white;">New Product</h5>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-lg-3 text-end">
                    <label asp-for="CategoryId" class="form-label"></label><em class="text-danger"> * </em>:
                </div>
                <div class="col-lg-3">
                    <select asp-for="CategoryId" asp-items="@ViewBag.Category" class="form-control">
                        <option value="-1" selected>--Select--</option>
                    </select>
                    <span class="error text-danger" asp-validation-for="CategoryId"></span>
                </div>
                <div class="col-lg-1 text-end">
                    <label asp-for="BrandId" class="form-label"></label><em class="text-danger"> * </em>:
                </div>
                <div class="col-lg-3">
                    <select asp-for="BrandId" asp-items="@ViewBag.Brand" class="form-control">
                        <option value="-1" selected>--Select--</option>
                    </select>
                        <span class="error text-danger" asp-validation-for="BrandId"></span>
                </div>
            </div>
            <div class="row">
                <div class="col-lg-6">
                    <div class="row mt-2">
                        <div class="col-lg-6 text-end">
                            <label class="form-label" asp-for="ProductName"></label><em class="text-danger"> * </em>:
                        </div>
                        <div class="col-lg-6">
                            <input type="text" class="form-control" asp-for="ProductName" />
                                <span class="error text-danger" asp-validation-for="ProductName"></span>
                        </div>
                    </div>
                    <div class="row mt-2">
                        <div class="col-lg-6 text-end">
                            <label class="form-label" asp-for="ProductCode"></label><em class="text-danger"> * </em>:
                        </div>
                        <div class="col-lg-6">
                            <input class="form-control" asp-for="ProductCode" />
                                <span class="error text-danger" asp-validation-for="ProductCode"></span>
                        </div>
                    </div>
                    <div class="row mt-2">
                        <div class="col-lg-6 text-end">
                            <label class="form-label" asp-for="BasePrice"></label><em class="text-danger"> * </em>:
                        </div>
                        <div class="col-lg-6">
                            <input  asp-for="BasePrice" class="form-control" />
                                <span class="error text-danger" asp-validation-for="BasePrice"></span>
                        </div>
                    </div>
                    <div class="row mt-2">
                        <div class="col-lg-6 text-end">
                            <label class="form-label " asp-for="ProductImage"></label><em class="text-danger"> * </em>:
                        </div>
                        <div class="col-lg-6">
                                <input type="file" name="ProductImage" asp-for="ProductImage" class="form-control ProductImages" accept=".png,.jpg,.jpeg" multiple />
                                <span class="error text-danger" asp-validation-for="ProductImage"></span>
                            </div>
                    </div>
                </div>
                <div class="col-lg-5">
                    <div class="row mt-1">
                        <div class="col-lg-5 px-2 col-8" style="height:180px;">
                            <img class="displayImage" src="" alt="not found" style="height:100%;width:100%;border:1px solid white;border-radius:10px;"  />
                        </div>
                        <div class="col-lg-2 col-2 flex-container">
                            <div class="flex-items">
                                    <img class="ImgStyle hover-img" src="" alt="Image 1" id="img1" draggable="false" />
                            </div>
                            <div class="flex-items">
                                    <img class="ImgStyle hover-img" src="" alt="Image 2" id="img2" draggable="false" />
                            </div>
                            <div class="flex-items">
                                    <img class="ImgStyle hover-img" src="" alt="Image 3" id="img3" draggable="false" />
                            </div>
                        </div>
                        <div class="col-lg-2 col-2 flex-container">
                            <div class="flex-items">
                                    <img class="ImgStyle hover-img" src="" alt="Image 4" id="img4" draggable="false" />
                            </div>
                            <div class="flex-items">
                                    <img class="ImgStyle hover-img" src="" alt="Image 5" id="img5" draggable="false" />
                            </div>
                            </div>
                    </div>
                </div>
            </div>
            <div class="row mt-2">
                <div class="col-lg-3 text-end">
                    <label asp-for="ProductDesc" class="form-label"></label><em class="text-danger"> * </em>:
                </div>
                <div class="col-lg-7">
                    <textarea asp-for="ProductDesc" class="form-control"></textarea>
                        <span class="error text-danger" asp-validation-for="ProductDesc"></span>
                </div>
            </div>
            <div class="row mt-1">
                <div class="col-lg-3 text-end">
                    <label asp-for="IsAvaliable" class="form-label"></label><em class="text-danger"> * </em>:
                </div>
            
            <div class="col-lg-3">
                <label>
                    <input type="radio" id="Yes" name="Avaliable" asp-for="IsAvaliable" value="1" class="highlight" />
                    <label for="Yes" class="form-label mx-2" >Yes</label>
                        <input type="radio" id="No" name="Avaliable" class="mx-1 highlight" asp-for="IsAvaliable" value="0" checked />
                    <label for="No" class="form-label">No</label>
                </label>
            </div>
            </div>
            <div class="ProductHighlight mt-1 mb-3">
                <div class="row">
                    <label class="d-flex justify-content-center">
                    <div class="col-lg-8 mx-2 col-8">
                                <div class="row mt-1 mb-1">
                                    <div class="col-lg-12">
                                        <input type="file" class="form-control" id="FileHighlight1" accept="png,jpeg,jpg,gif" asp-for="HighlightImage1" />
                                        <span class="error text-danger HighlightImage1"></span>
                                </div>
                                </div>
                        <div class="row">
                            <div class="col-lg-12">
                                        <textarea id="ProductHigh1" asp-for="productHighlight1" class="form-control" style="height:180px;" placeholder="Product Highlight's "></textarea>
                                        <span class="error text-danger ProductHighlight1"></span>
                            </div>
                        </div>
                        
                            
                    </div>
                    <div class="col-lg-2 col-4">
                      <img style="width:100%;height:100%;border-radius:10px;" src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcQE3CETL_OertJKScoHfblxs6CBrKGVCmVESw&s" />
                    </div>
                    </label>
                </div>
                <div class="row mt-2">
                    <label class="d-flex justify-content-center">
                        <div class="col-lg-2 mx-2 col-4">
                                <img style="width:100%;height:100%;border-radius:10px;" src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcQE3CETL_OertJKScoHfblxs6CBrKGVCmVESw&s" />
                        </div>
                        <div class="col-lg-8 col-8">
                            <div class="row mt-1 mb-1">
                                <div class="col-lg-12">
                                        <input type="file" asp-for="HighlightImage2" id="FileHighlight2" class="form-control" accept="image/png, image/jpg, image/jpeg, image/gif" />
                                        <span class="error text-danger HighlightImage2"></span>
                                    </div>
                            </div>
                            <div class="row">
                                <div class="col-lg-12">
                                        <textarea id="ProductHigh2" asp-for="productHighlight2" class="form-control" style="height:180px;" placeholder="Product Highlight's "></textarea>
                                        <span class="error text-danger ProductHighlight2"></span>
                                    </div>
                            </div>
                        </div>
                        
                    </label>
                </div>
                <div class="row mt-2">
                    <label class="d-flex justify-content-center">
                        <div class="col-lg-8 mx-2 col-8">
                            <div class="row mt-1 mb-1">
                                <div class="col-lg-12">
                                        <input type="file" class="form-control" id="FileHighlight3" accept="image/png,image/jpg,image/jpeg,image/gif" />
                                        <span class="error text-danger HighlightImage3"></span>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-lg-12">
                                        <textarea id="ProductHigh3" asp-for="productHighlight3" class="form-control" style="height:180px;" placeholder="Product HighLight's "></textarea>
                                        <span class="error text-danger ProductHighlight3"></span>
                                    </div>
                            </div>
                        </div>
                        <div class="col-lg-2 col-4">
                                <img style="width:100%;height:100%;border-radius:10px;z-index:100;" src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcQE3CETL_OertJKScoHfblxs6CBrKGVCmVESw&s" />
                        </div>
                    </label>
                </div>

            </div>
            <div class="row mt-2">
                <div class="col-lg-12 text-center">
                    <button type="button" id="btnback" class="btn btn-secondary col-1">Back</button>
                    <button type="submit" id="btnsave" class="btn btn-primary col-1">Save</button>
                    <button type="reset" id="btnclear" class="btn btn-primary col-1">Clear</button>
                </div>
            </div>
        </div>
    </div>
<br />
</div>
</form>
@section Scripts{
    <partial name="_ValidationScriptsPartial"></partial>
}
<script type="text/javascript">
    $(function () {
        $('.form-control').attr('autocomplete', 'off');
        $('.highlight').on("click", function () {
            debugger;
            var chkvalue = $(this).val();
            if(parseInt(chkvalue)!=0)
            {
                $('.ProductHighlight').css("display", "block");
            }
            else{
                $('.ProductHighlight').css("display", "none");
            }
        });

        $('.displayImage,.hover-img').attr("src", "https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcQE3CETL_OertJKScoHfblxs6CBrKGVCmVESw&s");
       
        $('.ProductImages').on('change', function (event) {
            debugger
            $('.displayImage,.hover-img').attr("src", "https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcQE3CETL_OertJKScoHfblxs6CBrKGVCmVESw&s");
            var Images = event.target.files;
            if(Images.length<=5)
            {
                for (let i = 0; i < Images.length;i++)
                {
                    if (Images[i].size <= (1 * 1024 * 1024)) {
                        const reader = new FileReader();
                        reader.onloadend=function(){
                            const base64 = reader.result;
                            if (i == 0) { 
                                $('.displayImage').attr("src", base64);
                            }
                            var img = $("#img" +(i+1));
                            img.attr("src", base64);
 
                        }
                        reader.readAsDataURL(Images[i]);
                    }

                }
            }
            else{
                alert("You Can Upload 5 Images less than 1MB each")
            }

        });

        $('.hover-img').on('mouseover', function () {
            const displayImage = $('.displayImage'); 
            var srcValue = $(this).attr('src'); // Get the src of the hovered image
            displayImage.attr("src", srcValue).show(); // Set the src and show the display image
        });

        $('.hover-img').on('mouseout', function () {
            $('#displayImage').hide(); 
        });

        $('form').on('click', '#btnsave', function () {
            debugger
            var vform = $('form').valid();

            var choice = $('input[name="Avaliable"]:checked').val();
            if (parseInt(choice) == 1 && vform==false) {
                    if ($('#FileHighlight1').val() == "" && $('#FileHighlight2').val() == "" && $('#FileHighlight3').val() == "") {
                        $('.HighlightImage1,.HighlightImage2,.HighlightImage3').text('Upload Image - Image Should Be .png, .jpg, .jpeg, .gif and Image Size Should Be Less than 5MB');
                        return false;
                    }
                    // if ($('#ProductHigh1').val() == "" && $('#ProductHigh1').val() == "" && $('#ProductHigh1').val() == "") {
                    //     $('.ProductHighlight1,.ProductHighlight2,.ProductHighlight3').text("Enter Product Highlight Description");
                    //     return false;
                    // }
                }
            else if (vform==false) {
                $('.HighlightImage1,.HighlightImage2,.HighlightImage3').text('');
                    return false;
                }
            
        });

    });
</script>
